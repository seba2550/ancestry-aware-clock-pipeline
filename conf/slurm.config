/*
========================================================================================
    SLURM Profile — Generalizable cluster execution profile
========================================================================================
*/

process {
    executor = 'slurm'
    queue    = { params.slurm_queue ?: 'standard' }

    // Dynamic queue / partition overrides can be set via --slurm_queue
}

params {
    config_profile_name        = 'SLURM profile'
    config_profile_description = 'Cluster execution using SLURM workload manager'
    slurm_queue                = null
}
