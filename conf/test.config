/*
========================================================================================
    Test Profile — Minimal synthetic dataset configuration
========================================================================================
*/

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal synthetic dataset to validate pipeline pipeline syntax and execution'

    // Limit resources for test profile
    max_cpus   = 2
    max_memory = '4.GB'
    max_time   = '1.h'

    // Downsample bootstrap for test profile
    n_bootstrap = 2

    // Synthetic test input files
    is_test_run = true
    test_data_dir = "${projectDir}/tests/test_data"
}
