/*
========================================================================================
    Ancestry-Aware Methylation Clock Pipeline Config
========================================================================================
*/

// Load default parameters and base resource limits at top level
includeConfig 'conf/params.config'
includeConfig 'conf/base.config'

profiles {
    standard {
        docker.enabled       = true
        docker.userEmulation = true
        singularity.enabled  = false
    }
    docker {
        docker.enabled       = true
        docker.userEmulation = true
        singularity.enabled  = false
    }
    singularity {
        singularity.enabled  = true
        singularity.autoMounts = true
        docker.enabled       = false
    }
    test {
        includeConfig 'conf/test.config'
    }
    slurm {
        includeConfig 'conf/slurm.config'
    }
}

// Container mappings per process label
process {
    withLabel: 'container_python' {
        container = "${params.container_registry}/clock-training:1.0.0"
    }
    withLabel: 'container_r' {
        container = "${params.container_registry}/r-bioconductor:1.0.0"
    }
    withLabel: 'container_prs' {
        container = "${params.container_registry}/prs-tools:1.0.0"
    }
}

manifest {
    name            = 'ancestry-aware-clock-pipeline'
    author          = 'Capra Lab'
    homePage        = 'https://github.com/seba2550/ancestry-aware-clock-pipeline'
    description     = 'Portable and ancestral composition-balanced epigenetic clock pipeline'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=22.10.0'
    version         = '1.0.0'
}
